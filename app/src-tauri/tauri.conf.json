{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "clustervision",
  "version": "0.18.0",
  "identifier": "town.lunar.clustervision",
  "build": {
    "frontendDist": "../../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "clustervision",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Cross-harness AI session viewer.",
    "longDescription": "clustervision wraps the static web session viewer (timeline, compare, stats, splice composer, fleet dashboard), reads sessions through the in-process read API, and launches a local `cv serve` on startup."
  }
}
